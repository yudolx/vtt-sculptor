  "scripts": {
    "build": "cross-env NODE_ENV=production webpack",
    "start": "cross-env NODE_ENV=development WATCH=true webpack",
    "electron": "electron ./compiled/main-process.js",
    "plugins:watch": "cross-env NODE_PRESERVE_SYMLINKS=1 node ./scripts/build-plugins.mjs",
    "plugins:build": "cross-env NODE_PRESERVE_SYMLINKS=1 NODE_ENV=production node ./scripts/build-plugins.mjs build",
